<Window x:Class="PulseCore.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PulseCore"
        Width="1200" Height="750" MinWidth="800" MinHeight="500"
        WindowStyle="None" AllowsTransparency="False"
        Background="#090b10" WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <!-- CaptionHeight=0: el arrastre lo gestiona la barra HTML vía puente (DragMove).
             Se mantiene el redimensionado por bordes y el snap de Windows. -->
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Background="#090b10">
        <wv2:WebView2 x:Name="WebView" />
    </Grid>
</Window>
